includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - routes/
        - database/

    # 0〜9（数字が大きいほど厳しい）。5は引数の型の不一致まで検査する
    level: 5

    # モデルの casts() メソッドの中身（return の配列）を読む（既定では戻り値の型宣言しか見ないため、canceled_at が Carbon にならない）
    parseModelCastsMethod: true
