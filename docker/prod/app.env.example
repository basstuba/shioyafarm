# 本番用（公開デモ）の環境変数の見本。docker/prod/app.env にコピーして、値を入れて使う（app.env は .gitignore 対象。コミットしない）。
#   cp docker/prod/app.env.example docker/prod/app.env
# このファイルは次の2つに使われる（compose.prod.yaml）。
#   1. docker compose の --env-file（compose.prod.yaml の ${SITE_DOMAIN} などの置き換え）
#   2. app コンテナの環境変数（env_file）
# 値に空白を含むときは "" で囲む。$ は使わない（Compose が変数として置き換えてしまうため）。

# ---- Compose・Caddy ----

# サイトのドメイン（DuckDNS のサブドメイン。Caddy が Let's Encrypt の証明書を自動で取得する。ローカルの確認は localhost）
SITE_DOMAIN=xxx.duckdns.org

# 公開するポート（既定は 80・443。ローカルで開発用の compose.yaml と同時に確認するときだけ変える）
#HTTP_PORT=80
#HTTPS_PORT=443

# アップロード画像（storage/app/public）を置くホストのディレクトリ（絶対パス。app と caddy の両方に重ねる）。
# あらかじめ作り、app コンテナのユーザー（UID 1000）が書き込めるようにしておく。
# 画像のフリー素材（商品画像・アイコンなど）は、リポジトリに無い（再配布不可）。reset.sh が DEMO_ASSETS_DIR から書き戻す。
STORAGE_PUBLIC_DIR=/srv/shioyafarm/storage-public

# 画像の保管場所（フリー素材と、リポジトリの logo を image/{icon,product,tool}/ の形で置いたディレクトリ）。
# scripts/demo/reset.sh が、毎日の作り直しのたびに STORAGE_PUBLIC_DIR へ書き戻す（rsync --delete。管理画面からアップロードした画像は消える）。
# STORAGE_PUBLIC_DIR とは別のディレクトリにする。reset.sh の引数でも指定できる。
DEMO_ASSETS_DIR=/srv/shioyafarm/assets-master

# ---- Laravel の基本 ----

APP_NAME="Shioya Farm"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
# サイトの URL（https。SITE_DOMAIN と同じドメインにする）
APP_URL=https://xxx.duckdns.org
# アプリケーションキー。空欄のままでは起動しない。作り方（イメージを作ってから）：
#   docker compose -f compose.prod.yaml --env-file docker/prod/app.env run --rm --no-deps app php artisan key:generate --show
# 出てきた base64:... をここに貼る。変えると、暗号化したもの（セッションなど）が読めなくなる。
APP_KEY=

# ---- ログ ----

# docker compose logs で見られるよう、標準エラー出力へ出す（ファイルに溜めない）
LOG_CHANNEL=stderr
# info 以上を出す。debug にすると、コントローラーの Log::debug と、MAIL_MAILER=log のメール本文も出る（調べるときだけ）
LOG_LEVEL=info

# ---- データベース（compose.prod.yaml の mysql サービス。ポートは公開しない） ----

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sf_db
DB_USERNAME=sf_user
# 長いランダムな文字列にする（例：openssl rand -hex 24）
DB_PASSWORD=CHANGE_ME

# ---- セッション・キャッシュ・キュー ----

SESSION_DRIVER=database
SESSION_LIFETIME=120
# HTTPS だけでクッキーを送る
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# キューのワーカーは使わない（メールは defer で送る）
QUEUE_CONNECTION=sync

# ---- メール ----

# 公開デモでは実際には送らない（ログに出すだけ）。実在のメールアドレスに送らないため
MAIL_MAILER=log
MAIL_FROM_ADDRESS="shioyafarm@example.com"
MAIL_FROM_NAME="しおや農園"

# ---- 認証 ----

# 管理者の二段階認証（メールのコード）。メールを送らないデモではオフにする
ADMIN_TWO_FACTOR_ENABLED=false
# 会員登録の送信の回数制限（同じIPアドレスから1分あたりの回数）
REGISTER_THROTTLE_PER_MINUTE=5

# ---- Stripe（テストモードのキー。pk_test_... / sk_test_...） ----

STRIPE_KEY=
STRIPE_SECRET=

# ---- プロキシ ----

# 信頼するプロキシの IP アドレス・CIDR（カンマ区切り。* なら直接つながってきた相手をすべて信頼）。
# 回数制限が数える IP アドレスと、https の判定が、X-Forwarded-For・X-Forwarded-Proto に従うようになる。
# 今回の構成（インターネットから Caddy に直接つなぐ）では、空のままでよい。
# php_fastcgi では、PHP が見る接続元（REMOTE_ADDR）は Caddy に接続してきた相手になる。Caddy に直接つなぐなら、それが本当のクライアントなので、
# X-Forwarded-For・X-Forwarded-Proto を信頼する必要がない（Caddy が https かどうかも PHP に渡す）。
# Cloudflare など、Caddy の前にさらにプロキシを置くときは、次の2か所の設定がそろって初めて、本当のクライアントの IP と https を PHP が受け取れる。
#   1. Caddy 側：docker/prod/Caddyfile の先頭に、グローバルオプション（servers { trusted_proxies static <そのプロキシの IP 範囲> }）を足す（Caddy が X-Forwarded-* を信頼する相手を決める）
#   2. Laravel 側：この TRUSTED_PROXIES に、同じプロキシの IP 範囲を指定する
# どちらかだけでは足りない。Cloudflare の IP 範囲は変わることがあるため、公式の一覧（https://www.cloudflare.com/ips/）を確かめて使う。
# Compose のネットワークの範囲（172.16.0.0/12 など）を指定するものではない。それは Caddy と PHP の間の接続元であり、本当のクライアントの IP ではない。
TRUSTED_PROXIES=

# ---- 公開デモ ----

# true にすると、公開側と管理画面のすべてのページの上部に、デモサイトの案内（実在の個人情報を入れない・メールは送らない・毎日午前4時に初期化）を出す
DEMO_NOTICE=true
# true のときだけ scripts/demo/reset.sh が動く（DB と画像を作り直す。本番のデータがある環境では絶対に true にしない）
DEMO_RESET_ALLOWED=true
